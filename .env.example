# managesys docker-compose 환경변수 예시
# 사용:  cp .env.example .env   후 값을 채워 넣으세요. (.env 는 커밋 금지)

# 개인정보 AES-256-GCM 암호화 키 (Base64 인코딩 32바이트 = 44자, 필수)
#   생성:  openssl rand -base64 32
#   ⚠ 분실 시 기존 암호문 복호화 불가 → 안전하게 백업할 것
APP_ENCRYPTION_KEY=

# MariaDB 루트 비밀번호 / 기본 DB명
MARIADB_ROOT_PASSWORD=1234
MARIADB_DATABASE=managesys
